# No Xcode or Python requirement in ordinary builds: verify and copy frozen data.
function(krose_add_macos_icon target)
  set(_resources "${CMAKE_SOURCE_DIR}/src/plugin/resources")
  set(_compiled "${_resources}/macos-icon")
  file(GLOB_RECURSE _source CONFIGURE_DEPENDS LIST_DIRECTORIES false "${_resources}/Krose.icon/*")
  # Detect importing/removing the first precompiled catalog without a manual configure.
  file(GLOB _frozen CONFIGURE_DEPENDS "${_compiled}/Assets.car" "${_compiled}/manifest.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_compiled}/manifest.json" "${_compiled}/Assets.car" ${_source})
  if(NOT EXISTS "${_compiled}/Assets.car" AND NOT EXISTS "${_compiled}/manifest.json")
    message(STATUS "Krose: precompiled layered icon not present; using static ICNS")
    # A prior build may have copied a catalog that is no longer in the checkout.
    add_custom_command(TARGET ${target} POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E rm -f "$<TARGET_BUNDLE_DIR:${target}>/Contents/Resources/Assets.car")
    return()
  endif()
  file(READ "${_compiled}/manifest.json" _manifest)
  string(JSON _format GET "${_manifest}" format)
  string(JSON _name GET "${_manifest}" icon_name)
  if(NOT _format EQUAL 1 OR NOT _name STREQUAL "Krose")
    message(FATAL_ERROR "Unsupported compiled Krose icon manifest")
  endif()
  list(SORT _source)
  set(_inventory "")
  foreach(_file IN LISTS _source)
    file(RELATIVE_PATH _relative "${_resources}/Krose.icon" "${_file}")
    file(SHA256 "${_file}" _hash)
    string(APPEND _inventory "${_relative}:${_hash}\n")
  endforeach()
  string(SHA256 _hash "${_inventory}")
  string(JSON _expected GET "${_manifest}" source_sha256)
  if(NOT _hash STREQUAL _expected)
    message(FATAL_ERROR "Krose icon source changed; regenerate its precompiled catalog")
  endif()
  file(SHA256 "${_compiled}/Assets.car" _hash)
  string(JSON _expected GET "${_manifest}" assets_sha256)
  if(NOT _hash STREQUAL _expected)
    message(FATAL_ERROR "Krose compiled icon checksum mismatch")
  endif()
  target_sources(${target} PRIVATE "${_compiled}/Assets.car")
  set_source_files_properties("${_compiled}/Assets.car" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
  set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${_compiled}/Assets.car")
  file(READ "${_resources}/Krose-macOS-Info.plist" _plist)
  string(REPLACE "<key>CFBundleIconFile</key>"
    "<key>CFBundleIconName</key>\n\t<string>Krose</string>\n\t<key>CFBundleIconFile</key>" _plist "${_plist}")
  set(_output "${CMAKE_CURRENT_BINARY_DIR}/Krose-layered-Info.plist")
  file(CONFIGURE OUTPUT "${_output}" CONTENT "${_plist}" @ONLY)
  set_target_properties(${target} PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${_output}")
  message(STATUS "Krose: verified precompiled system-appearance icon")
endfunction()
