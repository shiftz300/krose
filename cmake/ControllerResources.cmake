option(KROSE_BUNDLE_CONTROLLERS "Bundle maintained controller adapters and extension templates" ON)
function(krose_controller_resources)
  file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/controller-kit/mode.txt"
    CONTENT "${KROSE_BUNDLE_CONTROLLERS}\n")
  foreach(_target Krose-app Krose-vst3)
    set_property(TARGET ${_target} APPEND PROPERTY LINK_DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/controller-kit/mode.txt")
  endforeach()
  if(NOT KROSE_BUNDLE_CONTROLLERS)
    foreach(_target Krose-app Krose-vst3)
      if(APPLE)
        set(_dest "$<TARGET_BUNDLE_DIR:${_target}>/Contents/Resources/Controllers")
      elseif(_target STREQUAL "Krose-app")
        set(_dest "${CMAKE_BINARY_DIR}/out/Resources/Controllers")
      else()
        set(_dest "${CMAKE_BINARY_DIR}/out/Krose.vst3/Contents/Resources/Controllers")
      endif()
      add_custom_command(TARGET ${_target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E rm -rf "${_dest}" VERBATIM)
    endforeach()
    return()
  endif()
  file(GLOB_RECURSE _controller_sources CONFIGURE_DEPENDS LIST_DIRECTORIES false "${CMAKE_SOURCE_DIR}/controllers/*")
  set(_tool "${CMAKE_SOURCE_DIR}/tools/build_controller_resources.py")
  set(_stage "${CMAKE_CURRENT_BINARY_DIR}/controller-kit/Controllers")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_controller_sources}
    "${_tool}" "${CMAKE_SOURCE_DIR}/tools/install_ableton_controller.py"
    "${CMAKE_SOURCE_DIR}/docs/CONTROLLERS.md" "${CMAKE_SOURCE_DIR}/LICENSE"
    "${CMAKE_SOURCE_DIR}/assets/program-library/FactoryPrograms.json"
    "${CMAKE_SOURCE_DIR}/assets/program-library/FactoryBrowser.json")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${_tool}" "${_stage}" RESULT_VARIABLE _result)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Cannot prepare built-in controller kit")
  endif()
  file(GLOB_RECURSE _files LIST_DIRECTORIES false "${_stage}/*")
  foreach(_target Krose-app Krose-vst3)
    set_property(TARGET ${_target} APPEND PROPERTY LINK_DEPENDS ${_files})
    if(APPLE)
      set(_dest "$<TARGET_BUNDLE_DIR:${_target}>/Contents/Resources/Controllers")
    elseif(WIN32)
      if(_target STREQUAL "Krose-app")
        set(_dest "${CMAKE_BINARY_DIR}/out/Resources/Controllers")
      else()
        set(_dest "${CMAKE_BINARY_DIR}/out/Krose.vst3/Contents/Resources/Controllers")
      endif()
    endif()
    add_custom_command(TARGET ${_target} POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E rm -rf "${_dest}"
      COMMAND ${CMAKE_COMMAND} -E copy_directory "${_stage}" "${_dest}" VERBATIM)
  endforeach()
endfunction()
