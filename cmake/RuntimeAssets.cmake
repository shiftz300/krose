# Frozen product/test inputs only. No firmware or research scripts are executed.
function(segrand_check_asset_bundle folder)
  set(_manifest "${folder}/manifest.json")
  if(NOT EXISTS "${_manifest}")
    message(FATAL_ERROR "Missing frozen asset bundle: ${folder}. Obtain the bundle or explicitly run python3 research/tools/export_runtime_assets.py in the research workspace.")
  endif()
  file(READ "${_manifest}" _json)
  string(JSON _version GET "${_json}" format_version)
  if(NOT _version EQUAL 1 AND NOT _version EQUAL 2)
    message(FATAL_ERROR "Unsupported asset manifest: ${_manifest}")
  endif()
  string(JSON _count LENGTH "${_json}" files)
  math(EXPR _last "${_count} - 1")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
  foreach(_index RANGE 0 ${_last})
    string(JSON _name GET "${_json}" files ${_index} file)
    string(JSON _expected GET "${_json}" files ${_index} sha256)
    if(_name MATCHES "[/\\\\]" OR _name STREQUAL "" OR _name STREQUAL "..")
      message(FATAL_ERROR "Invalid asset name in ${_manifest}")
    endif()
    if(NOT EXISTS "${folder}/${_name}")
      message(FATAL_ERROR "Missing frozen asset: ${folder}/${_name}")
    endif()
    file(SHA256 "${folder}/${_name}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Frozen asset checksum mismatch: ${folder}/${_name}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${folder}/${_name}")
  endforeach()
endfunction()
